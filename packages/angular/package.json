{
  "name": "@speechineer/angular",
  "version": "0.7.1",
  "description": "Build voice-based documentation into your Angular app — provideSpeechineer() and one inject function per capability, with state as signals.",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "NOTICE"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "type-check": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "keywords": [
    "speechineer",
    "voice-documentation",
    "dictation",
    "speech-to-text",
    "voice-input",
    "structured-data",
    "speech-to-form",
    "ai-forms",
    "angular",
    "signals"
  ],
  "license": "Apache-2.0",
  "author": "Aicendence GmbH",
  "homepage": "https://github.com/speechineer/speechineer-js#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/speechineer/speechineer-js.git",
    "directory": "packages/angular"
  },
  "bugs": {
    "url": "https://github.com/speechineer/speechineer-js/issues"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "dependencies": {
    "@speechineer/js": "0.7.1"
  },
  "peerDependencies": {
    "@angular/core": ">=17"
  },
  "devDependencies": {
    "@angular/core": "^21.2.0",
    "rxjs": "^7.8.1",
    "tsup": "^8",
    "typescript": "^5.9.3"
  }
}
