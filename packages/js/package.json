{
  "name": "@speechineer/js",
  "version": "0.7.0",
  "description": "Build voice-based documentation into any web app \u2014 spoken or typed input becomes structured, typed values in real time. Framework-free.",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "NOTICE"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "format": "biome format",
    "lint": "biome lint",
    "check": "biome check",
    "check:fix": "biome check --write",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "clean": "rm -rf dist"
  },
  "keywords": [
    "speechineer",
    "voice-documentation",
    "dictation",
    "speech-to-text",
    "voice-input",
    "structured-data",
    "speech-to-form",
    "ai-forms",
    "forms"
  ],
  "license": "Apache-2.0",
  "author": "Aicendence GmbH",
  "homepage": "https://github.com/speechineer/speechineer-js#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/speechineer/speechineer-js.git",
    "directory": "packages/js"
  },
  "bugs": {
    "url": "https://github.com/speechineer/speechineer-js/issues"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "devDependencies": {
    "@biomejs/biome": "2.3.10",
    "tsup": "^8",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10"
  }
}
