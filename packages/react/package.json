{
  "name": "@speechineer/react",
  "version": "0.7.1",
  "description": "Build voice-based documentation into your React app — a provider and one hook per capability turn speech or text into structured, typed values.",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "NOTICE"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "type-check": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "keywords": [
    "speechineer",
    "voice-documentation",
    "dictation",
    "speech-to-text",
    "voice-input",
    "structured-data",
    "speech-to-form",
    "ai-forms",
    "react",
    "hooks"
  ],
  "license": "Apache-2.0",
  "author": "Aicendence GmbH",
  "homepage": "https://github.com/Speechineer/speechineer-js#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Speechineer/speechineer-js.git",
    "directory": "packages/react"
  },
  "bugs": {
    "url": "https://github.com/Speechineer/speechineer-js/issues"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "dependencies": {
    "@speechineer/js": "0.7.1"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "devDependencies": {
    "@types/react": "^18.3.28",
    "react": "^18.3.1",
    "tsup": "^8",
    "typescript": "^5.9.3"
  }
}
